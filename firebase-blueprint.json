{
  "entities": {
    "Admin": {
      "title": "Admin Configuration",
      "description": "A document identifying an administrator. The document ID is the admin's UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the admin."
        }
      },
      "required": ["email"]
    },
    "ProjectItem": {
      "title": "Project Item",
      "description": "A portfolio project item created and managed by the administrator.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "badge": { "type": "string", "maxLength": 50 },
        "categories": { "type": "array", "items": { "type": "string" } },
        "hyperlink": { "type": "string" },
        "githubUrl": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["title", "description", "mediaUrl"]
    },
    "CertificateItem": {
      "title": "Certificate Item",
      "description": "A verified credential or certificate managed by the administrator.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "issuer": { "type": "string", "maxLength": 100 },
        "issueDate": { "type": "string", "maxLength": 50 },
        "expirationDate": { "type": "string", "maxLength": 50 },
        "credentialId": { "type": "string", "maxLength": 100 },
        "credentialUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "skills": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["title", "issuer", "imageUrl"]
    },
    "PublicComment": {
      "title": "Public Comment",
      "description": "A comment or reply submitted in the public comments space.",
      "type": "object",
      "properties": {
        "authorName": {
          "type": "string",
          "maxLength": 60,
          "description": "Display name or Anonymous."
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Whether the author chose to be anonymous."
        },
        "content": {
          "type": "string",
          "maxLength": 1000,
          "description": "The text content of the comment."
        },
        "parentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Parent comment ID if this is a reply."
        },
        "replyToAuthor": {
          "type": "string",
          "maxLength": 60,
          "description": "Name of the parent comment author."
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Server timestamp when the comment was posted."
        }
      },
      "required": ["authorName", "isAnonymous", "content", "createdAt"]
    },
    "SiteContent": {
      "title": "Site Content",
      "description": "Dynamic content for the website.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "about": { "type": "string" },
        "photoUrl": { "type": "string" },
        "photoPath": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "github": { "type": "string" },
            "linkedin": { "type": "string" },
            "email": { "type": "string" }
          }
        },
        "whatIDoCategories": {
          "type": "array",
          "description": "List of What I Do categories/div cards.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "order": { "type": "number" },
              "visible": { "type": "boolean" }
            }
          }
        },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "FeatureComponent": {
      "title": "Feature Component",
      "description": "An interactive UI/animation component stored in the component library.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "code": { "type": "string" },
        "css": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["name", "category", "code", "status"]
    }
  },
  "firestore": {
    "/features/{componentId}": {
      "schema": {
        "$ref": "#/entities/FeatureComponent"
      },
      "description": "Collection storing interactive feature components and animations."
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/ProjectItem"
      },
      "description": "Collection storing portfolio projects created in dashboard."
    },
    "/certificates/{certificateId}": {
      "schema": {
        "$ref": "#/entities/CertificateItem"
      },
      "description": "Collection storing verified credentials and certificates."
    },
    "/comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/PublicComment"
      },
      "description": "Collection storing public comments and replies."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Collection storing authorized administrator IDs."
    },
    "/site_content/{documentId}": {
      "schema": {
        "$ref": "#/entities/SiteContent"
      },
      "description": "Collection storing dynamic site content like profile data."
    }
  }
}
