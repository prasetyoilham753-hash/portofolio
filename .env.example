# Environment Variables
# Disable Vite HMR when true (configured by AI Studio)
DISABLE_HMR=true

# Authorized Administrator Email (Optional client reference; primary authorization is Firestore admins/{uid})
VITE_ADMIN_EMAIL=

# Firebase App Check (reCAPTCHA Enterprise site key for production bot and flood defense)
VITE_RECAPTCHA_SITE_KEY=

# Firebase App Check Debug Token (Optional: UUID token registered in Firebase Console for dev/testing)
VITE_APPCHECK_DEBUG_TOKEN=

# ==============================================================================
# Google Analytics 4 (GA4) Configuration
# ==============================================================================
# FRONTEND / CLIENT-SIDE TRACKING:
# Your GA4 Web Stream Measurement ID (Format: G-XXXXXXXXXX)
# Safe for browser/client exposure. Used to collect pageviews and user events on bintangprasetyo.com.
VITE_GA_MEASUREMENT_ID=G-Q8VPHD4S7V
