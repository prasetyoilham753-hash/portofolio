rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Boot connection test
    match /test/connection {
      allow read: if true;
    }

    // ==========================================
    // PRIMITIVE HELPERS
    // ==========================================
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'prasetyoilham753@gmail.com' ||
        request.auth.token.email == 'contact@bintangprasetyo.com'
      );
    }

    // Server-side forbidden phrase filter (stops direct SDK calls with spam, gambling, or script injections)
    function hasNoServerBannedPhrases(text) {
      return !text.matches('(?i).*(slot|judol|judi|gacor|scam|porn|casino|togel|<script|javascript:).*');
    }

    // ==========================================
    // ENTITY VALIDATION HELPERS
    // ==========================================
    function isValidComment(data) {
      let isAuthorValid = data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 && hasNoServerBannedPhrases(data.authorName);
      let isAnonValid = data.isAnonymous is bool;
      let isContentValid = data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 && hasNoServerBannedPhrases(data.content);
      let isCreatedAtValid = data.createdAt == request.time;
      let isParentValid = !('parentId' in data) || (data.parentId is string && data.parentId.size() <= 128);
      let isReplyAuthorValid = !('replyToAuthor' in data) || (data.replyToAuthor is string && data.replyToAuthor.size() <= 60);

      let hasRequiredKeys = data.keys().hasAll(['authorName', 'isAnonymous', 'content', 'createdAt']);
      let hasOnlyAllowedKeys = data.keys().hasOnly(['authorName', 'isAnonymous', 'content', 'createdAt', 'parentId', 'replyToAuthor']);

      return hasRequiredKeys && hasOnlyAllowedKeys && isAuthorValid && isAnonValid && isContentValid && isCreatedAtValid && isParentValid && isReplyAuthorValid;
    }

    // ==========================================
    // COLLECTIONS
    // ==========================================
    
    // 1. Public Comments & Replies
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) && isValidComment(incoming());
      allow delete: if isValidId(commentId) && isAdmin();
      allow update: if isValidId(commentId) && isAdmin();
    }

    // 2. Admins
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isValidId(adminId) && (isAdmin() || (isSignedIn() && request.auth.uid == adminId && (request.auth.token.email == 'prasetyoilham753@gmail.com' || request.auth.token.email == 'contact@bintangprasetyo.com')));
    }

    // 3. Site Content (e.g. profile, about, gallery, certificates)
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Portfolio Projects
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId) && isAdmin();
    }

    // 5. Art Gallery Items
    match /gallery/{artworkId} {
      allow read: if true;
      allow write: if isValidId(artworkId) && isAdmin();
    }

    // 6. Verified Certificates & Credentials
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isValidId(certificateId) && isAdmin();
    }

    // 7. Feature Components (UI/UX Component Library)
    match /features/{componentId} {
      allow read: if true;
      allow write: if isValidId(componentId) && isAdmin();
    }
  }
}
