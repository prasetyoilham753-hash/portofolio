rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Boot connection test
    match /test/connection {
      allow read: if true;
    }

    // ==========================================
    // PRIMITIVE HELPERS
    // ==========================================
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'prasetyoilham753@gmail.com'
      ); 
    }

    // ==========================================
    // ENTITY VALIDATION HELPERS
    // ==========================================
    function isValidComment(data) {
      let isAuthorValid = data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 60;
      let isAnonValid = data.isAnonymous is bool;
      let isContentValid = data.content is string && data.content.size() > 0 && data.content.size() <= 1000;
      let isCreatedAtValid = data.createdAt == request.time;
      let isParentValid = !('parentId' in data) || (data.parentId is string && data.parentId.size() <= 128);
      let isReplyAuthorValid = !('replyToAuthor' in data) || (data.replyToAuthor is string && data.replyToAuthor.size() <= 60);

      let hasRequiredKeys = data.keys().hasAll(['authorName', 'isAnonymous', 'content', 'createdAt']);
      let hasOnlyAllowedKeys = data.keys().hasOnly(['authorName', 'isAnonymous', 'content', 'createdAt', 'parentId', 'replyToAuthor']);

      return hasRequiredKeys && hasOnlyAllowedKeys && isAuthorValid && isAnonValid && isContentValid && isCreatedAtValid && isParentValid && isReplyAuthorValid;
    }

    function isValidQnAMessage(data) {
      let isCategoryValid = data.category in ["Question", "Idea", "Feedback", "Collaboration", "Other"];
      let isMessageValid = data.message is string && data.message.size() > 0 && data.message.size() <= 500;
      let isNicknameValid = !('nickname' in data) || (data.nickname is string && data.nickname.size() <= 50);
      let isCreatedAtValid = data.createdAt == request.time;
      
      let expectedKeySize = ('nickname' in data) ? 4 : 3;
      let hasCorrectKeys = data.keys().hasAll(['category', 'message', 'createdAt']) && data.keys().size() == expectedKeySize;

      return hasCorrectKeys && isCategoryValid && isMessageValid && isNicknameValid && isCreatedAtValid;
    }

    // ==========================================
    // COLLECTIONS
    // ==========================================
    
    // 1. Public Comments & Replies
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) && isValidComment(incoming());
      allow delete: if isValidId(commentId) && isAdmin();
      allow update: if isValidId(commentId) && isAdmin();
    }

    // 2. QnA Messages
    match /qna_messages/{messageId} {
      allow read: if isAdmin();
      allow delete: if isValidId(messageId) && isAdmin();
      allow create: if isValidId(messageId) && isValidQnAMessage(incoming());
      allow update: if isValidId(messageId) && isAdmin();
    }

    // 2. Admins
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // System / Console only
    }

    // 3. Site Content (e.g. profile, about, gallery, certificates)
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Portfolio Projects
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId) && isAdmin();
    }

    // 5. Art Gallery Items
    match /gallery/{artworkId} {
      allow read: if true;
      allow write: if isValidId(artworkId) && isAdmin();
    }
  }
}
